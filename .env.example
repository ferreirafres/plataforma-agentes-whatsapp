# Opcional: necessário para respostas de IA e transcrição de áudio.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# A configuração padrão só abre portas no próprio computador.
AGENTES_PORT=8820
MCP_PORT=3000
WHATSAPP_NAME="Meu WhatsApp"

# Ao usar proxy HTTPS, configure o endereço externo do MCP e os hops confiáveis.
# MCP_PUBLIC_URL=https://mcp.example.org
# COOKIE_SECURE=1
# AGENTES_PROXY_HOPS=1
# MCP_PROXY_HOPS=1

# Google Drive é opcional e requer um cliente OAuth próprio.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DRIVE_TOKEN_ENCRYPTION_KEY=
# PRIVACY_CONTACT_EMAIL=
